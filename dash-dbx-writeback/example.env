# =============================================================================
# Environment Configuration for Dash Databricks Writeback Application
# =============================================================================
#
# Copy this file to .env and fill in your values:
#   cp example.env .env
#
# IMPORTANT: The .env file is gitignored and should NEVER be committed
#
# =============================================================================

# =============================================================================
# RECOMMENDED: Simplified Configuration (for Local Development)
# =============================================================================
#
# This is the EASIEST way to configure local development!
# Just set the instance name - everything else is auto-populated via WorkspaceClient.
#
# Prerequisites:
# 1. Install Databricks CLI: pip install databricks-cli
# 2. Authenticate: databricks configure --token
# 3. Set LAKEBASE_INSTANCE_NAME below
#
# The application will automatically:
# - Get PGUSER from: w.current_user.me().user_name
# - Get PGHOST from: w.database.get_database_instance(name=instance_name).read_write_dns
# - Generate OAuth tokens automatically for connections

# Your Lakebase instance name (REQUIRED for local development)
LAKEBASE_INSTANCE_NAME=your-instance-name

# Database name (optional, defaults to databricks_postgres)
LAKEBASE_DATABASE=databricks_postgres

# =============================================================================
# ALTERNATIVE: Full Manual Configuration (Advanced)
# =============================================================================
#
# Only use this if you need precise control or can't use WorkspaceClient.
# These are the same PG* variables that Databricks automatically injects when deployed.
# 
# When deployed to Databricks, the app.yml database resource automatically provides:
# PGHOST, PGPORT, PGDATABASE, PGUSER, PGSSLMODE
#
# To use manual configuration:
# 1. Comment out LAKEBASE_INSTANCE_NAME above
# 2. Uncomment and fill in all PG* variables below

# PGHOST=your-instance.cloud-region.dbsqlcloud.databricks.com
# PGPORT=5432
# PGDATABASE=databricks_postgres
# PGUSER=your-databricks-user@company.com
# PGSSLMODE=require

# =============================================================================
# Application Configuration
# =============================================================================

# Schema to use within the PostgreSQL database (default: public)
LAKEBASE_SCHEMA=public

# Optional: Connection pool settings
POOL_MIN_SIZE=1
POOL_MAX_SIZE=5

# =============================================================================
# Testing Configuration (Optional)
# =============================================================================
#
# These are only needed when running tests
# See tests/README.md for more information

# Test Database (optional - creates completely isolated test database)
# LAKEBASE_TEST_DATABASE=databricks_postgres_test

# Test Schema (default: test_schema)
# LAKEBASE_TEST_SCHEMA=test_schema

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================
#
# Example 1: RECOMMENDED (Simplified - for local development)
# ------------------------------------------------------------
# Just set the instance name!
#
# LAKEBASE_INSTANCE_NAME=daveok
# LAKEBASE_DATABASE=databricks_postgres
# LAKEBASE_SCHEMA=public
#
# This will automatically populate:
# - PGUSER → your-email@company.com (from WorkspaceClient)
# - PGHOST → daveok.<region>.dbsqlcloud.databricks.com (from WorkspaceClient)
# - PGPORT → 5432
# - PGSSLMODE → require
#
# Example 2: Full Manual Configuration (for advanced use or debugging)
# ---------------------------------------------------------------------
# Set all PG* variables explicitly:
#
# PGHOST=daveok.eastus2.azuredatabricks.net
# PGPORT=5432
# PGDATABASE=databricks_postgres
# PGUSER=david.okeeffe@databricks.com
# PGSSLMODE=require
# LAKEBASE_SCHEMA=public
#
# Example 3: Databricks Deployment (automatic - no .env needed)
# --------------------------------------------------------------
# When deployed to Databricks Apps, the database resource in app.yml
# automatically injects all PG* variables. No manual configuration needed!

# =============================================================================
# CONFIGURATION GUIDE
# =============================================================================
#
# Quick Start (3 steps):
# ----------------------
# 1. Install and configure Databricks CLI:
#    pip install databricks-cli
#    databricks configure --token
#
# 2. Set your instance name in .env:
#    LAKEBASE_INSTANCE_NAME=your-instance-name
#
# 3. Run the app:
#    export $(grep -v '^#' .env | xargs) && uv run python -m dash_dbx_writeback.app
#
# How It Works:
# -------------
# The application uses WorkspaceClient to auto-populate connection details:
# - w.current_user.me().user_name → PGUSER
# - w.database.get_database_instance(name=instance_name).read_write_dns → PGHOST
# - OAuth tokens are generated automatically per connection
# - No passwords needed - secure OAuth authentication throughout
#
# Two Configuration Modes:
# -------------------------
# 1. SIMPLIFIED (Recommended for Local):
#    - Set: LAKEBASE_INSTANCE_NAME
#    - Everything else auto-populated
#    - Requires: Databricks CLI configured
#
# 2. FULL MANUAL (Advanced or Production):
#    - Set all PG* variables explicitly
#    - When deployed to Databricks, these are injected via database resource
#    - Use for debugging or if WorkspaceClient unavailable
#
# Deployment to Databricks:
# --------------------------
# - The app.yml references "postgres-database" resource
# - Databricks automatically injects: PGHOST, PGPORT, PGDATABASE, PGUSER, PGSSLMODE
# - No .env file needed in production
# - LAKEBASE_INSTANCE_NAME not used when deployed
#
# Security:
# ---------
# - Never commit .env to version control (.gitignore prevents this)
# - Databricks CLI stores credentials securely
# - OAuth tokens are short-lived and auto-rotated
# - Use least-privilege database permissions
#
# Finding Your Instance Name:
# ----------------------------
# 1. Go to Databricks Workspace → SQL → Databases
# 2. Locate your Lakebase database instance
# 3. Copy the instance name (e.g., "daveok", "my-lakebase")
# 4. This is NOT the full hostname, just the name
#
# Troubleshooting:
# ----------------
# - "PGHOST not set": Ensure LAKEBASE_INSTANCE_NAME is set
# - "Could not auto-populate": Run `databricks configure --token`
# - "Connection refused": Check instance is running in Databricks
# - "Permission denied": Verify database permissions in workspace
# - "Instance not found": Confirm instance name is correct

